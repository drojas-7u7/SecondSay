# Application
APP_NAME=SecondSay
APP_ENV=development
DEBUG=true

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://secondsay:secondsay@localhost:5432/secondsay

# LLM mode
# Supported values: cloud, local
LLM_MODE=cloud

# Cloud LLM
CLOUD_LLM_PROVIDER=groq
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=openai/gpt-oss-20b

# Local LLM
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=qwen3:4b-instruct
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
